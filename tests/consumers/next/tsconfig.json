{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true,
    "noUncheckedSideEffectImports": true, "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": false, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true,
    "plugins": [{"name": "next"}]
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
