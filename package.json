{
  "name": "@meapri/prism-glass",
  "version": "0.5.0-alpha.2",
  "description": "Source-first liquid glass for DOM and media, with a TypeScript core and accessible React controls.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "llms.txt",
    "llms-full.txt",
    "api.json",
    "docs/*.md",
    "docs/LUCIDE_LICENSE.txt",
    "examples/recipes"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./optics": {
      "types": "./dist/optics.d.ts",
      "import": "./dist/optics.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./llms.txt": "./llms.txt",
    "./llms-full.txt": "./llms-full.txt",
    "./api.json": "./api.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "test": "npm run build && node --test tests/*.test.mjs && node scripts/check-package.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build:lib",
    "test:browser": "npm run build && node scripts/test-browser.mjs",
    "build:lib": "node scripts/build-library.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "docs:check": "node scripts/generate-ai-docs.mjs --check",
    "test:package": "npm run build:lib && node scripts/check-package.mjs",
    "test:consumers": "npm run build:lib && node scripts/test-consumers.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.48.0",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Meapri/prism-glass.git"
  },
  "homepage": "https://meapri.github.io/prism-glass/",
  "bugs": {
    "url": "https://github.com/Meapri/prism-glass/issues"
  },
  "keywords": [
    "liquid-glass",
    "react",
    "typescript",
    "webgl",
    "ui-components"
  ]
}
