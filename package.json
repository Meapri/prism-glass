{
  "name": "@meapri/prism-glass",
  "version": "0.2.0-alpha.2",
  "description": "Source-first liquid glass for DOM and media, with a TypeScript core and accessible React controls.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs",
    "README.ko.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./optics": {
      "types": "./dist/optics.d.ts",
      "import": "./dist/optics.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "build:pages": "npm run build && node scripts/build-pages.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test:browser": "npm run build && node scripts/test-browser.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
